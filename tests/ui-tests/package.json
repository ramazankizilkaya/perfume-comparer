{
  "name": "perfume-comparer-ui-test",
  "version": "1.0.0",
  "description": "UI Test Suite for Aura Compare Web using Playwright and Cucumber",
  "license": "ISC",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:wip": "cucumber-js --tags @wip",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:serial": "cucumber-js --parallel 1",
    "report:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "report:open": "allure open reports/allure-report",
    "report": "npm run report:generate && npm run report:open"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.1",
    "@playwright/test": "^1.59.1",
    "allure-commandline": "^2.38.1",
    "allure-cucumberjs": "^3.7.1",
    "js-yaml": "^4.1.0"
  }
}
