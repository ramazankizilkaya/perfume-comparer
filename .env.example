# =============================================================================
# Frontend (Next.js) ortam değişkenleri.
#
# Kullanım:  cp .env.example .env
# .env commit edilmez (.gitignore'da). Deploy'da bu satırlar gerçek ortam
# değişkeni olarak tanımlanır; ortamda tanımlı bir değer .env'i EZER.
#
# BACKEND SIRLARI BURADA DEĞİL: bağlantı dizesi, Gemini/Anthropic anahtarları ve
# JWT secret src/PerfumeComparer/appsettings.Local.json içindedir
# (şablonu appsettings.Local.example.json).
#
# NOT: NEXT_PUBLIC_ ile başlayan her değer tarayıcıya gönderilir, yani gizli
# değildir. Buraya asla gerçek bir sır yazma.
# =============================================================================

# .NET API'nin adresi. Canlıda mutlaka gerçek adres verilmeli; verilmezse parfüm
# görselleri ve paylaşım (Open Graph) görselleri localhost'u gösterir.
NEXT_PUBLIC_API_BASE=http://localhost:5026

# Sitenin herkese açık adresi (sonunda / olmadan). Canonical, sitemap, robots.txt ve
# JSON-LD adresleri bununla kurulur. Boş bırakılırsa https://parfumetre.com kullanılır.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google ile giriş için OAuth istemci kimliği (public client id).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Sunucu tarafı (server component, generateMetadata, sitemap) API istekleriyle gönderilen
# gizli anahtar: X-Internal-Key başlığı. API bu anahtarı gören istekleri IP bazlı hız
# sınırından muaf tutar; aksi halde Next sunucusunun tek IP'si tüm ziyaretçiler adına
# sayılır ve sayfalar 429/500'e düşer. Backend tarafındaki iç anahtar ile AYNI olmalıdır.
# NEXT_PUBLIC_ ile BAŞLAMAZ: tarayıcıya gitmez. Canlıda zorunludur (build kontrolü arar).
API_INTERNAL_KEY=

# Build sırasındaki canlı adres kontrolü (next.config.ts):
# - `next build` (NODE_ENV=production) varsayılan olarak KATIDIR: NEXT_PUBLIC_SITE_URL ve
#   NEXT_PUBLIC_API_BASE boşsa, localhost içeriyorsa ya da https:// ile başlamıyorsa,
#   API_INTERNAL_KEY veya NEXT_PUBLIC_GOOGLE_CLIENT_ID tanımsızsa build DURUR.
# - Yerel makinede deneme build'i almak için DEPLOY_ENV=local yazın; aynı kontroller
#   yalnızca uyarı olarak basılır. Canlı sunucuda bu değer ASLA "local" olmamalıdır.
# - DEPLOY_ENV=production ise kontroller her koşulda katıdır.
# DEPLOY_ENV=local
