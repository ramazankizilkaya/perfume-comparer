# =============================================================================
# Frontend (Next.js) ortam değişkenleri.
#
# Kullanım:  cp .env.example .env
# .env commit edilmez (.gitignore'da). Deploy'da bu satırlar gerçek ortam
# değişkeni olarak tanımlanır; ortamda tanımlı bir değer .env'i EZER.
#
# BACKEND SIRLARI BURADA DEĞİL: bağlantı dizesi, Gemini/Anthropic anahtarları ve
# JWT secret src/PerfumeComparer/appsettings.Local.json içindedir
# (şablonu appsettings.Local.example.json).
#
# NOT: NEXT_PUBLIC_ ile başlayan her değer tarayıcıya gönderilir, yani gizli
# değildir. Buraya asla gerçek bir sır yazma.
# =============================================================================

# .NET API'nin adresi. Canlıda mutlaka gerçek adres verilmeli; verilmezse parfüm
# görselleri ve paylaşım (Open Graph) görselleri localhost'u gösterir.
NEXT_PUBLIC_API_BASE=http://localhost:5026

# Sitenin herkese açık adresi (sonunda / olmadan). Canonical, sitemap, robots.txt ve
# JSON-LD adresleri bununla kurulur. Boş bırakılırsa https://auracompare.com kullanılır.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google ile giriş için OAuth istemci kimliği (public client id).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
