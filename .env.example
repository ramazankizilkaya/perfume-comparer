# =============================================================================
# Aura Compare — Tüm Proje Ortam Değişkenleri (.env)
#
# Kullanım:  cp .env.example .env
# .env commit edilmez (.gitignore'da).
# Tüm Frontend, Backend, Python ve Node.js kazıma/AI scriptleri anahtarları
# doğrudan bu dosyadan otomatik okur.
#
# NOT: NEXT_PUBLIC_ ile başlayan değerler tarayıcıya iletilir. Sırlar (API key'ler)
# asla NEXT_PUBLIC_ ile başlamaz.
# =============================================================================

# --- FRONTEND (Next.js) ---
# .NET API'nin adresi.
NEXT_PUBLIC_API_BASE=http://localhost:5026

# Sitenin herkese açık adresi.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google ile giriş için OAuth istemci kimliği.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook ile giriş: App ID (isteğe bağlı).
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Sunucu -> API iç anahtar (X-Internal-Key). Rate limit muafiyeti için.
API_INTERNAL_KEY=

# Canlı/yerel dağıtım kontrolü:
# DEPLOY_ENV=local

# --- AI API ANAHTARLARI (Backend, Rephrase, Scraper, Enrich) ---
# Gemini API Anahtarı (Google AI Studio)
GEMINI_API_KEY=

# OpenAI API Anahtarı (İsteğe bağlı)
OPENAI_API_KEY=

# Groq API Anahtarı (İsteğe bağlı)
GROQ_API_KEY=

# --- SCRAPER & PROXY AYARLARI ---
# NordVPN Service Credentials (nordaccount.com -> Manual Setup)
NORD_SERVICE_USER=
NORD_SERVICE_PASS=

# Scraper VPN rotasyon ayarları (isteğe bağlı)
SCRAPER_VPN_ROTATE=1
SCRAPER_VPN_MAX_ATTEMPTS=2
